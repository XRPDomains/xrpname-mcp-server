# x402 Gateway payer config. Copy to .env and fill in. NEVER commit .env (holds a seed).

# REQUIRED — payer wallet seed (mainnet = real value). Dedicated agent wallet.
XRPL_SEED=

# Mode 1 (pay): the x402 resource to pay. Or pass as CLI arg: node pay.mjs <url>
# RESOURCE_URL=https://xrpdomains.xyz/mcp/x402/pay/demo-tips
# HTTP_METHOD=GET
# BODY={}

# Mode 2 (pay-to-NFT): the NFT endpoint. Default = XRPName domain registration.
NFT_ENDPOINT=https://xrpdomains.xyz/mcp/x402/register
# ITEM=alice.xrp

# Network: xrpl:0 = mainnet · xrpl:1 = testnet
XRPL_NETWORK=xrpl:0
XRPL_RPC=wss://xrplcluster.com
