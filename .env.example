# XRPName MCP Server — environment template (Phase 1)
# Copy to .env and adjust. Never commit .env.

# Backend REST API (pure consumer — no DB access)
XRPDOMAINS_API_BASE=https://xrpdomains.xyz

# XRPL network
XRPL_WSS_URL=wss://xrplcluster.com

# Treasury (registration Payment destination) — mirrors v3/networks-mainnet.js
XRPDOMAINS_TREASURY_ADDRESS=raAyazbgEkwzLByXipQuPLWFfnsPS1v1q9

# Pricing (mirrors v3/networks-mainnet.js + search.html tiers)
PRICING_BASE_PRICE_XRP=10
PRICING_DISCOUNT_PERCENT=50

# Redis — optional in Buoc 0; falls back to in-memory cache when unset.
# Also backs rate limiting (atomic INCR). In-memory works for single-instance dev.
# REDIS_URL=redis://localhost:6379

# Rate limiting (§12.1). Per fixed window; keyed by authed address, else IP.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_READ_PER_MIN=60
RATE_LIMIT_UNAUTH_PER_MIN=30
RATE_LIMIT_WINDOW_SEC=60

# DEV ONLY — fake authenticated XRPL address until OAuth (Buoc 3) ships.
# Used by get_portfolio / get_pending_offers when no address arg is given.
# DEV_ADDRESS=rXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

LOG_LEVEL=info
PORT=3000

# Usage analytics (powers GET /mcp/stats + /mcp/stats.json).
# Persisted to disk so numbers survive restarts. No raw IPs stored (only salted
# hashes for unique-visitor counts).
MCP_ANALYTICS_ENABLED=true
MCP_ANALYTICS_FILE=./data/analytics.json
# Set a secret to unlock the detailed view: /mcp/stats.json?token=...  (and
# /mcp/stats?token=...). Leave unset to expose only the public summary.
# MCP_STATS_TOKEN=change-me-to-a-long-random-string

# Domain registration (x402 write path). Contract wallet = the Payment
# destination AND the NFT minter. Defaults to the treasury address above;
# override only if networks-mainnet.js#contractAddress differs.
# XRPDOMAINS_CONTRACT_ADDRESS=raAyazbgEkwzLByXipQuPLWFfnsPS1v1q9
XRPDOMAINS_NFT_BASE_URI=https://mainnet.xrpdomains.xyz/api/nftdomains/metadata/
XRPDOMAINS_NETWORK=MAINNET

# Agentic registration via x402 (POST /mcp/x402/register). Money path.
# Gateway ON with REAL pricing from pricing.json.
X402_ENABLED=true
X402_FACILITATOR_URL=https://xrpl-facilitator-mainnet.t54.ai
X402_SOURCE_TAG=804681468
# TEST ONLY — force a fixed XRP price (e.g. 0.1) for a cheap throwaway run.
# 0 = use the real price. Only works if the backend agrees on the same amount.
X402_TEST_PRICE_XRP=0
