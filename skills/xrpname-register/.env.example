# Copy to .env and fill in. NEVER commit .env — it holds a wallet seed.

# REQUIRED — payer wallet seed (mainnet = real XRP). Needs price + ~1-2 XRP
# reserve + fees.
XRPL_BUYER_SEED=

# Optional — a default domain if you don't pass one on the CLI.
# DOMAIN=alice.xrp

# Endpoint (leave as-is for production).
RESOURCE_URL=https://xrpdomains.xyz/mcp/x402/register

# Network: xrpl:0 = mainnet · xrpl:1 = testnet
XRPL_NETWORK=xrpl:0
XRPL_RPC=wss://xrplcluster.com
